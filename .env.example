# Copie ce fichier en .env et adapte les valeurs.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de donnees ---
# Laisse ces lignes commentees pour utiliser SQLite (aucune install requise).
# Decommente pour PostgreSQL (docker-compose fournit ce service).
# POSTGRES_DB=legalflow
# POSTGRES_USER=legalflow
# POSTGRES_PASSWORD=legalflow
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Signature electronique (OTP) ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# En prod reelle, le code OTP part par SMS / e-mail. Faute de passerelle SMS pour
# la demo, on peut le renvoyer dans la reponse de l'API en mettant ceci a True.
# Par defaut : True seulement si DJANGO_DEBUG=True.
# OTP_EXPOSE_CODE=False
